# Copy this file to .env and fill in your access tokens.

# MLSPIN — same token you use for the Greater-Newburyport and
# Housing-Affordability-Crisis repos.
BRIDGE_TOKEN=your_server_access_token_here
BRIDGE_DATASET=mlspin

# Follow Up Boss API key (used by pipelines/fetch_fub.js).
# Generate from https://app.followupboss.com/2/api → API → Generate New
# Used to pull aggregate CRM stats (smart-list counts, recent activity);
# never any individual contact PII is written to data/processed/.
FUB_API_KEY=fka_your_fub_api_key_here
